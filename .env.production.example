# Template .env untuk PRODUKSI (server JagoanHosting)
# Salin file ini menjadi ".env" di folder aplikasi (Application Root) di server,
# lalu isi nilai sesuai yang dibuat di cPanel.
# JANGAN pernah commit file .env asli ke repository.

# ==== Database (buat via cPanel > MySQL Databases) ====
# Nama DB & user di cPanel otomatis diberi prefix username cPanel (contoh: jagouser_edudaya)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=GANTI_NAMA_DATABASE
DB_USERNAME=GANTI_USER_DATABASE
DB_PASSWORD=GANTI_PASSWORD_DATABASE

# ==== Keamanan (isi dengan string acak BARU, jangan pakai kredensial lokal) ====
# Contoh generate:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=GANTI_DENGAN_STRING_ACAK
SECRET_KEY=GANTI_DENGAN_STRING_ACAK

# ==== DeepSeek AI (opsional; hanya untuk batch analysis pretest & final) ====
# Catatan: kode membaca variabel DEEPSEEK_API_KEY (bukan OPENROUTER_API_KEY)
DEEPSEEK_API_KEY=
