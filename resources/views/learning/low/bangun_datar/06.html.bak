<!doctype html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <title>Segiempat (Belah Ketupat, Trapesium, Layang-Layang) — Edudaya</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Fredoka+One&display=swap" rel="stylesheet">
    <script>tailwind.config = { theme: { extend: { fontFamily: { nunito: ['Nunito', 'sans-serif'], fredoka: ['Fredoka One', 'cursive'] } } } }</script>
</head>

<body class="font-nunito bg-gradient-to-br from-cyan-50 via-green-50 to-yellow-50 min-h-screen flex">
    <div id="sidebarOverlay" onclick="closeSidebar()" class="hidden fixed inset-0 bg-black/40 z-[99]"></div>
    {% include 'learning/partial/sidebar.html' %}
    <div id="mainArea" class="ml-[280px] flex-1 flex flex-col min-h-screen transition-all duration-300">
        <nav class="sticky top-0 z-[101] bg-white border-b-2 border-gray-200 px-5 py-3 flex items-center justify-between shadow-sm flex-shrink-0">
            <div class="flex items-center gap-3">
                <span id="menuToggleBtn" onclick="toggleSidebar()" class="text-[1.8rem] cursor-pointer text-gray-700 hover:text-emerald-500"><ion-icon name="menu-outline"></ion-icon></span>
                <span class="font-fredoka text-lg text-gray-700">⬜ Segiempat Lanjut</span>
            </div>
        </nav>
        <div class="flex-1 px-6 py-6 bg-gradient-to-br from-cyan-50 via-green-50 to-yellow-50">
            <div class="max-w-5xl mx-auto flex flex-col gap-5">
                <div class="bg-white rounded-lg shadow-md overflow-hidden border-2 border-purple-100 flex flex-col">
                    <div class="bg-gradient-to-r from-purple-500 to-purple-600 px-5 py-5 text-center">
                        <h2 class="font-fredoka text-2xl text-white" style="text-shadow:2px 2px 0 rgba(0,0,0,0.15)">SEGIEMPAT</h2>
                        <p class="text-purple-50 text-sm font-bold mt-1">Belah Ketupat, Trapesium, Layang-Layang</p>
                    </div>
                    <div class="p-6 flex flex-col gap-5">
                        <!-- 4. BELAH KETUPAT -->
                        <div>
                            <h3 class="font-fredoka text-xl text-amber-700 mb-2">4. Belah Ketupat</h3>
                            <p class="text-sm text-gray-700 mb-3">Belah ketupat adalah bangun datar yang mempunyai empat sisi sama panjang.<br>Contoh: Ketupat Kandangan</p>
                            <figure class="bg-white rounded-xl overflow-hidden border-2 border-amber-200 shadow-sm max-w-xs mx-auto">
                                <img src="/resources/views/learning/low/bangun_datar/persegi_asset/img/27.jpg" alt="Ketupat Kandangan" class="w-full h-40 object-contain bg-white">
                                <figcaption class="px-3 py-2 text-xs font-bold text-gray-600 text-center">Ketupat Kandangan</figcaption>
                            </figure>
                        </div>
                        <div class="bg-gradient-to-br from-amber-50 to-amber-100 border-2 border-amber-200 rounded-2xl p-4">
                            <h4 class="font-fredoka text-lg text-amber-700 mb-3">Sifat-Sifat Belah Ketupat</h4>
                            <div class="grid gap-3">
                                <div class="bg-white rounded-xl p-3 border border-amber-200"><p class="text-sm font-bold text-amber-700 mb-2">• 4 titik sudut</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/titik_sudut_ketupat.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg"></div>
                                <div class="bg-white rounded-xl p-3 border border-amber-200"><p class="text-sm font-bold text-amber-700 mb-2">• 4 sisi</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/sisi_ketupat.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg"></div>
                                <div class="bg-white rounded-xl p-3 border border-amber-200"><p class="text-sm font-bold text-amber-700 mb-2">• 4 sudut</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/sudut_ketupat.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg"></div>
                                <div class="bg-white rounded-xl p-3 border border-amber-200"><p class="text-sm font-bold text-amber-700 mb-2">• Simetri lipat (ada 2)</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/simetri_lipat_ketupat.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg"></div>
                                <div class="bg-white rounded-xl p-3 border border-amber-200"><p class="text-sm font-bold text-amber-700 mb-2">• Simetri putar (ada 2)</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/simetri_putar_ketupat.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg"></div>
                            </div>
                        </div>
                        <div><h3 class="font-fredoka text-xl text-amber-700 mb-2">Keliling Belah Ketupat</h3><p class="text-sm text-gray-700 mb-3">Rumus: <strong>K = 4 × sisi</strong></p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/keliling_ketupat.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[320px] mx-auto h-auto rounded-lg border border-amber-200"></div>
                        <div class="bg-white rounded-2xl border-2 border-amber-200 overflow-hidden"><div class="bg-amber-50 px-4 py-2"><p class="font-fredoka text-amber-700">🎮 Coba Jawab! - Keliling Belah Ketupat</p></div><div class="p-4 space-y-3 text-sm text-gray-700"><p>Ketupat Kandangan bersisi 5 cm. Berapakah kelilingnya?</p><figure class="bg-white rounded-xl overflow-hidden border-2 border-amber-200 shadow-sm max-w-xs mx-auto"><img src="/resources/views/learning/low/bangun_datar/persegi_asset/img/28.jpg" alt="Ketupat Kandangan" class="w-full h-40 object-contain bg-white"><figcaption class="px-3 py-2 text-xs font-bold text-gray-600 text-center">Ketupat Kandangan</figcaption></figure><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/ketupat_persegi_lima_cm.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg"><div class="flex flex-col sm:flex-row gap-2"><input id="ans-q1" type="text" placeholder="Contoh: 20" onkeydown="if(event.key==='Enter')periksaSoal('q1')" class="flex-1 rounded-xl border-2 border-amber-200 px-4 py-2.5 text-sm"><button onclick="periksaSoal('q1')" class="bg-amber-500 hover:bg-amber-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button></div><div id="fb-q1"></div><div id="sol-q1" class="hidden bg-amber-50/60 rounded-xl p-3"><p class="font-bold text-amber-700 mb-1">Pembahasan:</p><p>K = 4 × 5 = <strong>20 cm</strong></p></div></div></div>
                        <div class="bg-white rounded-2xl border-2 border-amber-200 overflow-hidden"><div class="bg-amber-50 px-4 py-2"><p class="font-fredoka text-amber-700">🎮 Coba Jawab! - Mencari Sisi Belah Ketupat</p></div><div class="p-4 space-y-3 text-sm text-gray-700"><p>Motif sasirangan belah ketupat keliling 20 cm. Berapakah panjang sisinya?</p><figure class="bg-white rounded-xl overflow-hidden border-2 border-amber-200 shadow-sm max-w-xs mx-auto"><img src="/resources/views/learning/low/bangun_datar/persegi_asset/img/29.jpg" alt="Motif sasirangan" class="w-full h-40 object-contain bg-white"><figcaption class="px-3 py-2 text-xs font-bold text-gray-600 text-center">Motif Sasirangan</figcaption></figure><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/sasirangan_belah_ketupat_keliling.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg"><div class="flex flex-col sm:flex-row gap-2"><input id="ans-q2" type="text" placeholder="Contoh: 5" onkeydown="if(event.key==='Enter')periksaSoal('q2')" class="flex-1 rounded-xl border-2 border-amber-200 px-4 py-2.5 text-sm"><button onclick="periksaSoal('q2')" class="bg-amber-500 hover:bg-amber-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button></div><div id="fb-q2"></div><div id="sol-q2" class="hidden bg-amber-50/60 rounded-xl p-3"><p class="font-bold text-amber-700 mb-1">Pembahasan:</p><p>sisi = 20 ÷ 4 = <strong>5 cm</strong></p></div></div></div>
                        <div><h3 class="font-fredoka text-xl text-amber-700 mb-2">Luas Belah Ketupat</h3><p class="text-sm text-gray-700 mb-3">Rumus: <strong>L = ½ × d₁ × d₂</strong></p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/sasirangan_belah_ketupat_luas.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[320px] mx-auto h-auto rounded-lg border border-amber-200"></div>
                        <div class="bg-white rounded-2xl border-2 border-amber-200 overflow-hidden"><div class="bg-amber-50 px-4 py-2"><p class="font-fredoka text-amber-700">🎮 Coba Jawab! - Luas Belah Ketupat</p></div><div class="p-4 space-y-3 text-sm text-gray-700"><p>Motif belah ketupat diagonal 1 = 8 cm, diagonal 2 = 6 cm. Berapakah luasnya?</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/sasirangan_belah_ketupat_diagonal.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg"><div class="flex flex-col sm:flex-row gap-2"><input id="ans-q3" type="text" placeholder="Contoh: 24" onkeydown="if(event.key==='Enter')periksaSoal('q3')" class="flex-1 rounded-xl border-2 border-amber-200 px-4 py-2.5 text-sm"><button onclick="periksaSoal('q3')" class="bg-amber-500 hover:bg-amber-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button></div><div id="fb-q3"></div><div id="sol-q3" class="hidden bg-amber-50/60 rounded-xl p-3"><p class="font-bold text-amber-700 mb-1">Pembahasan:</p><p>L = ½ × 8 × 6 = <strong>24 cm²</strong></p></div></div></div>
                        <div class="bg-white rounded-2xl border-2 border-amber-200 overflow-hidden"><div class="bg-amber-50 px-4 py-2"><p class="font-fredoka text-amber-700">🎮 Coba Jawab! - Mencari Diagonal Belah Ketupat</p></div><div class="p-4 space-y-3 text-sm text-gray-700"><p>Luas 6 cm², diagonal 1 = 2 cm. Berapakah diagonal 2?</p><figure class="bg-white rounded-xl overflow-hidden border-2 border-amber-200 shadow-sm max-w-xs mx-auto"><img src="/resources/views/learning/low/bangun_datar/persegi_asset/img/30.jpg" alt="Hiasan manik-manik" class="w-full h-40 object-contain bg-white"><figcaption class="px-3 py-2 text-xs font-bold text-gray-600 text-center">Hiasan Manik-manik</figcaption></figure><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/manik_belah_ketupat_luas.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg"><div class="flex flex-col sm:flex-row gap-2"><input id="ans-q4" type="text" placeholder="Contoh: 6" onkeydown="if(event.key==='Enter')periksaSoal('q4')" class="flex-1 rounded-xl border-2 border-amber-200 px-4 py-2.5 text-sm"><button onclick="periksaSoal('q4')" class="bg-amber-500 hover:bg-amber-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button></div><div id="fb-q4"></div><div id="sol-q4" class="hidden bg-amber-50/60 rounded-xl p-3"><p class="font-bold text-amber-700 mb-1">Pembahasan:</p><p>6 = ½ × 2 × d₂ → d₂ = <strong>6 cm</strong></p></div></div></div>

                        <!-- 5. TRAPESIUM -->
                        <div><h3 class="font-fredoka text-xl text-cyan-700 mb-2">5. Trapesium</h3><p class="text-sm text-gray-700 mb-3">Trapesium adalah bangun datar yang mempunyai sepasang sisi sejajar.<br>Contoh: Atap Rumah Bumbungan Tinggi</p><figure class="bg-white rounded-xl overflow-hidden border-2 border-cyan-200 shadow-sm max-w-xs mx-auto"><img src="/resources/views/learning/low/bangun_datar/persegi_asset/img/31.jpg" alt="Atap Rumah Bumbungan Tinggi" class="w-full h-40 object-contain bg-white"><figcaption class="px-3 py-2 text-xs font-bold text-gray-600 text-center">Atap Rumah Bumbungan Tinggi</figcaption></figure></div>
                        <div class="bg-gradient-to-br from-cyan-50 to-cyan-100 border-2 border-cyan-200 rounded-2xl p-4"><h4 class="font-fredoka text-lg text-cyan-700 mb-3">Sifat-Sifat Trapesium</h4><div class="grid gap-3"><div class="bg-white rounded-xl p-3 border border-cyan-200"><p class="text-sm font-bold text-cyan-700 mb-2">• 4 titik sudut</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/bubungan_trapesium_empat_titik_sudut.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg"></div><div class="bg-white rounded-xl p-3 border border-cyan-200"><p class="text-sm font-bold text-cyan-700 mb-2">• 4 sisi</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/bubungan_trapesium_empat_sisi.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg"></div><div class="bg-white rounded-xl p-3 border border-cyan-200"><p class="text-sm font-bold text-cyan-700 mb-2">• 4 sudut</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/sudut_bumbungan_tinggi.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg"></div><div class="bg-white rounded-xl p-3 border border-cyan-200"><p class="text-sm font-bold text-cyan-700 mb-2">• Simetri lipat (ada 1)</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/simetri_lipat_bumbungan_tinggi.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg"></div><div class="bg-white rounded-xl p-3 border border-cyan-200"><p class="text-sm font-bold text-cyan-700 mb-2">• Simetri putar (tidak ada)</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/simetri_putar_bumbungan_tinggi.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg"></div></div></div>
                        <div><h3 class="font-fredoka text-xl text-cyan-700 mb-2">Keliling Trapesium</h3><p class="text-sm text-gray-700 mb-3">Rumus: <strong>K = sisi 1 + sisi 2 + sisi 3 + sisi 4</strong></p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/keliling_bumbungan_tinggi.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[320px] mx-auto h-auto rounded-lg border border-cyan-200"></div>
                        <div class="bg-white rounded-2xl border-2 border-cyan-200 overflow-hidden"><div class="bg-cyan-50 px-4 py-2"><p class="font-fredoka text-cyan-700">🎮 Coba Jawab! - Keliling Trapesium</p></div><div class="p-4 space-y-3 text-sm text-gray-700"><p>Atap trapesium sisi AB=8 cm, BC=5 cm, CD=6 cm, DA=5 cm. Berapakah kelilingnya?</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/keliling_bumbungan_tinggi_8_5_6_5.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg"><div class="flex flex-col sm:flex-row gap-2"><input id="ans-q5" type="text" placeholder="Contoh: 24" onkeydown="if(event.key==='Enter')periksaSoal('q5')" class="flex-1 rounded-xl border-2 border-cyan-200 px-4 py-2.5 text-sm"><button onclick="periksaSoal('q5')" class="bg-cyan-500 hover:bg-cyan-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button></div><div id="fb-q5"></div><div id="sol-q5" class="hidden bg-cyan-50/60 rounded-xl p-3"><p class="font-bold text-cyan-700 mb-1">Pembahasan:</p><p>K = 8 + 5 + 6 + 5 = <strong>24 cm</strong></p></div></div></div>
                        <div class="bg-white rounded-2xl border-2 border-cyan-200 overflow-hidden"><div class="bg-cyan-50 px-4 py-2"><p class="font-fredoka text-cyan-700">🎮 Coba Jawab! - Mencari Sisi Trapesium</p></div><div class="p-4 space-y-3 text-sm text-gray-700"><p>Keliling trapesium 18 m, tiga sisi 6 m, 4 m, 3 m. Berapakah sisi keempat?</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/keliling_atap_rumah_6_4_3.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg"><div class="flex flex-col sm:flex-row gap-2"><input id="ans-q6" type="text" placeholder="Contoh: 5" onkeydown="if(event.key==='Enter')periksaSoal('q6')" class="flex-1 rounded-xl border-2 border-cyan-200 px-4 py-2.5 text-sm"><button onclick="periksaSoal('q6')" class="bg-cyan-500 hover:bg-cyan-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button></div><div id="fb-q6"></div><div id="sol-q6" class="hidden bg-cyan-50/60 rounded-xl p-3"><p class="font-bold text-cyan-700 mb-1">Pembahasan:</p><p>18 = 6 + 4 + 3 + DA → DA = <strong>5 m</strong></p></div></div></div>
                        <div><h3 class="font-fredoka text-xl text-cyan-700 mb-2">Luas Trapesium</h3><p class="text-sm text-gray-700 mb-3">Rumus: <strong>L = ½ × (a + b) × t</strong></p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/luas_bumbungan_tinggi.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[320px] mx-auto h-auto rounded-lg border border-cyan-200"></div>
                        <div class="bg-white rounded-2xl border-2 border-cyan-200 overflow-hidden"><div class="bg-cyan-50 px-4 py-2"><p class="font-fredoka text-cyan-700">🎮 Coba Jawab! - Luas Trapesium</p></div><div class="p-4 space-y-3 text-sm text-gray-700"><p>Sisi sejajar 4 m dan 10 m, tinggi 3 m. Berapakah luasnya?</p><figure class="bg-white rounded-xl overflow-hidden border-2 border-cyan-200 shadow-sm max-w-xs mx-auto"><img src="/resources/views/learning/low/bangun_datar/persegi_asset/img/32.jpg" alt="Atap Rumah Bumbungan Tinggi" class="w-full h-40 object-contain bg-white"><figcaption class="px-3 py-2 text-xs font-bold text-gray-600 text-center">Atap Rumah Bumbungan Tinggi</figcaption></figure><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/luas_atap_4_10_3.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg"><div class="flex flex-col sm:flex-row gap-2"><input id="ans-q7" type="text" placeholder="Contoh: 21" onkeydown="if(event.key==='Enter')periksaSoal('q7')" class="flex-1 rounded-xl border-2 border-cyan-200 px-4 py-2.5 text-sm"><button onclick="periksaSoal('q7')" class="bg-cyan-500 hover:bg-cyan-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button></div><div id="fb-q7"></div><div id="sol-q7" class="hidden bg-cyan-50/60 rounded-xl p-3"><p class="font-bold text-cyan-700 mb-1">Pembahasan:</p><p>L = ½ × (4+10) × 3 = ½ × 14 × 3 = <strong>21 m²</strong></p></div></div></div>
                        <div class="bg-white rounded-2xl border-2 border-cyan-200 overflow-hidden"><div class="bg-cyan-50 px-4 py-2"><p class="font-fredoka text-cyan-700">🎮 Coba Jawab! - Mencari Tinggi Trapesium</p></div><div class="p-4 space-y-3 text-sm text-gray-700"><p>Luas 28 cm², sisi sejajar 8 cm dan 6 cm. Berapakah tingginya?</p><div class="flex flex-col sm:flex-row gap-2"><input id="ans-q8" type="text" placeholder="Contoh: 4" onkeydown="if(event.key==='Enter')periksaSoal('q8')" class="flex-1 rounded-xl border-2 border-cyan-200 px-4 py-2.5 text-sm"><button onclick="periksaSoal('q8')" class="bg-cyan-500 hover:bg-cyan-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaan</button></div><div id="fb-q8"></div><div id="sol-q8" class="hidden bg-cyan-50/60 rounded-xl p-3"><p class="font-bold text-cyan-700 mb-1">Pembahasan:</p><p>28 = ½ × (14) × t → 28 = 7 × t → t = <strong>4 cm</strong></p></div></div></div>

                        <!-- 6. LAYANG-LAYANG -->
                        <div><h3 class="font-fredoka text-xl text-pink-700 mb-2">6. Layang-Layang</h3><p class="text-sm text-gray-700 mb-3">Layang-layang adalah bangun datar yang mempunyai dua pasang sisi yang berdekatan sama panjang.<br>Contoh: mainan layang-layang</p><figure class="bg-white rounded-xl overflow-hidden border-2 border-pink-200 shadow-sm max-w-xs mx-auto"><img src="/resources/views/learning/low/bangun_datar/persegi_asset/img/33.jpg" alt="Mainan layang-layang" class="w-full h-40 object-contain bg-white"><figcaption class="px-3 py-2 text-xs font-bold text-gray-600 text-center">Layang-Layang</figcaption></figure></div>
                        <div class="bg-gradient-to-br from-pink-50 to-pink-100 border-2 border-pink-200 rounded-2xl p-4"><h4 class="font-fredoka text-lg text-pink-700 mb-3">Sifat-Sifat Layang-Layang</h4><div class="grid gap-3"><div class="bg-white rounded-xl p-3 border border-pink-200"><p class="text-sm font-bold text-pink-700 mb-2">• 4 titik sudut</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/layang_4_titik_sudut.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg"></div><div class="bg-white rounded-xl p-3 border border-pink-200"><p class="text-sm font-bold text-pink-700 mb-2">• 4 sisi</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/layang_4_sisi.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg"></div><div class="bg-white rounded-xl p-3 border border-pink-200"><p class="text-sm font-bold text-pink-700 mb-2">• 4 sudut</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/layang_4_sudut.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg"></div><div class="bg-white rounded-xl p-3 border border-pink-200"><p class="text-sm font-bold text-pink-700 mb-2">• Simetri lipat (ada 1)</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/layang_simetri_lipat.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg"></div><div class="bg-white rounded-xl p-3 border border-pink-200"><p class="text-sm font-bold text-pink-700 mb-2">• Simetri putar (tidak ada)</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/layang_simetri_putar.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg"></div></div></div>
                        <div><h3 class="font-fredoka text-xl text-pink-700 mb-2">Keliling Layang-Layang</h3><p class="text-sm text-gray-700 mb-3">Rumus: <strong>K = 2 × (sisi 1 + sisi 2)</strong></p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/keliling_layang_layang.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[320px] mx-auto h-auto rounded-lg border border-pink-200"></div>
                        <div class="bg-white rounded-2xl border-2 border-pink-200 overflow-hidden"><div class="bg-pink-50 px-4 py-2"><p class="font-fredoka text-pink-700">🎮 Coba Jawab! - Keliling Layang-Layang</p></div><div class="p-4 space-y-3 text-sm text-gray-700"><p>AB=AD=5 cm, BC=CD=7 cm. Berapakah kelilingnya?</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/layang_sisi_5_7.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg"><div class="flex flex-col sm:flex-row gap-2"><input id="ans-q9" type="text" placeholder="Contoh: 24" onkeydown="if(event.key==='Enter')periksaSoal('q9')" class="flex-1 rounded-xl border-2 border-pink-200 px-4 py-2.5 text-sm"><button onclick="periksaSoal('q9')" class="bg-pink-500 hover:bg-pink-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button></div><div id="fb-q9"></div><div id="sol-q9" class="hidden bg-pink-50/60 rounded-xl p-3"><p class="font-bold text-pink-700 mb-1">Pembahasan:</p><p>K = 5 + 7 + 7 + 5 = <strong>24 cm</strong></p></div></div></div>
                        <div class="bg-white rounded-2xl border-2 border-pink-200 overflow-hidden"><div class="bg-pink-50 px-4 py-2"><p class="font-fredoka text-pink-700">🎮 Coba Jawab! - Mencari Sisi Layang-Layang</p></div><div class="p-4 space-y-3 text-sm text-gray-700"><p>Keliling 24 cm, pasangan sisi 5 cm dan 7 cm. Berapakah panjang pasangan lainnya?</p><div class="flex flex-col sm:flex-row gap-2"><input id="ans-q10" type="text" placeholder="Contoh: 7" onkeydown="if(event.key==='Enter')periksaSoal('q10')" class="flex-1 rounded-xl border-2 border-pink-200 px-4 py-2.5 text-sm"><button onclick="periksaSoal('q10')" class="bg-pink-500 hover:bg-pink-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button></div><div id="fb-q10"></div><div id="sol-q10" class="hidden bg-pink-50/60 rounded-xl p-3"><p class="font-bold text-pink-700 mb-1">Pembahasan:</p><p>24 = 2 × (5 + sisi) → sisi = <strong>7 cm</strong></p></div></div></div>
                        <div><h3 class="font-fredoka text-xl text-pink-700 mb-2">Luas Layang-Layang</h3><p class="text-sm text-gray-700 mb-3">Rumus: <strong>L = ½ × d₁ × d₂</strong></p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/luas_layang_layang.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[320px] mx-auto h-auto rounded-lg border border-pink-200"></div>
                        <div class="bg-white rounded-2xl border-2 border-pink-200 overflow-hidden"><div class="bg-pink-50 px-4 py-2"><p class="font-fredoka text-pink-700">🎮 Coba Jawab! - Luas Layang-Layang</p></div><div class="p-4 space-y-3 text-sm text-gray-700"><p>Luas 24 cm², diagonal 1 = 8 cm. Berapakah diagonal 2?</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/layang_luas_24.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg"><div class="flex flex-col sm:flex-row gap-2"><input id="ans-q11" type="text" placeholder="Contoh: 6" onkeydown="if(event.key==='Enter')periksaSoal('q11')" class="flex-1 rounded-xl border-2 border-pink-200 px-4 py-2.5 text-sm"><button onclick="periksaSoal('q11')" class="bg-pink-500 hover:bg-pink-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button></div><div id="fb-q11"></div><div id="sol-q11" class="hidden bg-pink-50/60 rounded-xl p-3"><p class="font-bold text-pink-700 mb-1">Pembahasan:</p><p>24 = ½ × 8 × d₂ → d₂ = <strong>6 cm</strong></p></div></div></div>
                        <div class="bg-white rounded-2xl border-2 border-pink-200 overflow-hidden"><div class="bg-pink-50 px-4 py-2"><p class="font-fredoka text-pink-700">🎮 Coba Jawab! - Mencari Diagonal Layang-Layang</p></div><div class="p-4 space-y-3 text-sm text-gray-700"><p>Luas 24 cm², diagonal 1 = 6 cm. Berapakah diagonal 2?</p><img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/layang_luas_24_ac6.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg"><div class="flex flex-col sm:flex-row gap-2"><input id="ans-q12" type="text" placeholder="Contoh: 8" onkeydown="if(event.key==='Enter')periksaSoal('q12')" class="flex-1 rounded-xl border-2 border-pink-200 px-4 py-2.5 text-sm"><button onclick="periksaSoal('q12')" class="bg-pink-500 hover:bg-pink-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button></div><div id="fb-q12"></div><div id="sol-q12" class="hidden bg-pink-50/60 rounded-xl p-3"><p class="font-bold text-pink-700 mb-1">Pembahasan:</p><p>24 = ½ × 6 × d₂ → d₂ = <strong>8 cm</strong></p></div></div></div>
                    </div>
                </div>

                <div class="flex justify-between items-center flex-wrap gap-3 pb-4">
                    <a href="/learning/bangun_datar/05/{{ user_id }}/{{ klasifikasi }}" class="font-fredoka text-base px-6 py-2.5 rounded-lg bg-gradient-to-r from-emerald-500 to-emerald-600 text-white shadow-md">⬅️ Halaman Sebelumnya</a>
                    <p class="text-gray-400 text-xs font-semibold">© 2026 Edudaya 🔷</p>
                    <a href="/quiz/bangun_datar/{{ user_id }}/{{ klasifikasi }}" class="font-fredoka text-base px-6 py-2.5 rounded-lg bg-gradient-to-r from-blue-500 to-blue-600 text-white shadow-md">Lanjut ke Kuis ➡️</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        const JAWABAN_SOAL = { 'q1':20,'q2':5,'q3':24,'q4':6,'q5':24,'q6':5,'q7':21,'q8':4,'q9':24,'q10':7,'q11':6,'q12':8 };
        function periksaSoal(id){
            const input=document.getElementById('ans-'+id), fb=document.getElementById('fb-'+id), sol=document.getElementById('sol-'+id);
            if(!input||!fb)return;
            let val=input.value.trim().replace(/\s+/g,'');
            if(val===''){fb.innerHTML='<div class="bg-yellow-100 border-2 border-yellow-400 rounded-xl p-3 text-sm font-bold text-yellow-700">✏️ Tulis jawabanmu dulu ya!</div>';return;}
            const num=parseFloat(val.replace(',','.'));
            const ben=JAWABAN_SOAL[id];
            if(!isNaN(num)&&Math.abs(num-ben)<0.01){fb.innerHTML='<div class="bg-green-100 border-2 border-green-400 rounded-xl p-3 text-sm font-bold text-green-700">🎉 BENAR! Hebat!</div>'; if(sol)sol.classList.remove('hidden');}
            else{fb.innerHTML='<div class="bg-red-100 border-2 border-red-400 rounded-xl p-3 text-sm font-bold text-red-600">😊 BELUM TEPAT! Coba perhatikan lagi ya!</div>'; if(sol)sol.classList.remove('hidden');}
        }
        let sidebarOpen=true;
        function toggleSidebar(){const s=document.getElementById('sidebar'),m=document.getElementById('mainArea'),o=document.getElementById('sidebarOverlay'),mob=window.innerWidth<=768;if(mob){const h=s.classList.contains('-translate-x-full');if(h){s.classList.remove('-translate-x-full');o.classList.remove('hidden');o.classList.add('flex');}else{s.classList.add('-translate-x-full');o.classList.add('hidden');o.classList.remove('flex');}}else{sidebarOpen=!sidebarOpen;if(sidebarOpen){s.classList.remove('-translate-x-full');m.classList.remove('ml-0');m.classList.add('ml-[280px]');}else{s.classList.add('-translate-x-full');m.classList.remove('ml-[280px]');m.classList.add('ml-0');}}}
        function closeSidebar(){const s=document.getElementById('sidebar'),o=document.getElementById('sidebarOverlay');s.classList.add('-translate-x-full');o.classList.add('hidden');o.classList.remove('flex');}
        function toggleSidebarMenu(h){const i=h.querySelector('ion-icon'),l=h.nextElementSibling;const op=!l.classList.contains('hidden');l.classList.toggle('hidden',op);l.classList.toggle('flex',!op);i.style.transform=op?'':'rotate(180deg)';}
        function initSidebar(){var p=window.location.pathname;document.querySelectorAll('#sidebar a').forEach(function(a){if(a.getAttribute('href')&&p.startsWith(a.getAttribute('href').split('/').slice(0,5).join('/'))){var u=a.closest('ul');if(u&&u.classList.contains('hidden')){var hh=u.previousElementSibling;if(hh&&hh.querySelector('ion-icon')){u.classList.remove('hidden');u.classList.add('flex');hh.querySelector('ion-icon').style.transform='rotate(180deg)';}}}});}
        document.addEventListener('DOMContentLoaded',()=>{
            if(window.innerWidth<=768){document.getElementById('sidebar').classList.add('-translate-x-full');document.getElementById('mainArea').classList.remove('ml-[280px]');document.getElementById('mainArea').classList.add('ml-0');}
            initSidebar();
            const gifs=document.querySelectorAll('img.gif-lazy');
            if('IntersectionObserver' in window){const obs=new IntersectionObserver((entries)=>{entries.forEach(e=>{if(e.isIntersecting){const img=e.target;if(img.dataset.src){img.src=img.dataset.src;img.removeAttribute('data-src');}obs.unobserve(img);}});},{rootMargin:'50px'});gifs.forEach(g=>obs.observe(g));}else{gifs.forEach(img=>{if(img.dataset.src){img.src=img.dataset.src;img.removeAttribute('data-src');}});}
            document.querySelectorAll('img').forEach(img => {
                if(img.closest('#sidebar')||img.closest('nav')||img.id==='imgLightboxImg')return;
                if(img.src && !img.classList.contains('no-lightbox')){
                    img.style.cursor='zoom-in';
                    img.addEventListener('click',function(e){e.preventDefault();const lb=document.getElementById('imgLightbox'),lbi=document.getElementById('imgLightboxImg');if(lb&&lbi){lbi.src=img.currentSrc||img.src;lbi.alt=img.alt;lb.classList.remove('hidden');lb.classList.add('flex');document.body.style.overflow='hidden';}});
                }
            });
        });
    </script>
    <div id="imgLightbox" class="fixed inset-0 bg-black/80 hidden items-center justify-center z-[9999] p-4" onclick="document.getElementById('imgLightbox').classList.add('hidden');document.getElementById('imgLightbox').classList.remove('flex');document.body.style.overflow='';">
        <button class="absolute top-4 right-4 text-white text-3xl" onclick="event.stopPropagation();document.getElementById('imgLightbox').classList.add('hidden');document.getElementById('imgLightbox').classList.remove('flex');document.body.style.overflow='';">&times;</button>
        <img id="imgLightboxImg" src="" alt="Preview" class="max-w-full max-h-full rounded-lg shadow-2xl" onclick="event.stopPropagation()">
    </div>
</body>
</html>