<!doctype html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <title>Segiempat (Persegi, Persegi Panjang, Jajar Genjang) — Edudaya</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Fredoka+One&display=swap" rel="stylesheet">
    <script>tailwind.config = { theme: { extend: { fontFamily: { nunito: ['Nunito', 'sans-serif'], fredoka: ['Fredoka One', 'cursive'] } } } }</script>
</head>

<body class="font-nunito bg-gradient-to-br from-cyan-50 via-green-50 to-yellow-50 min-h-screen flex">
    <div id="sidebarOverlay" onclick="closeSidebar()" class="hidden fixed inset-0 bg-black/40 z-[99]"></div>
    <div class="fixed pointer-events-none text-3xl animate-float opacity-20 z-0" style="top:16%;left:62%;">⬜</div>
    <div class="fixed pointer-events-none text-3xl animate-float opacity-20 z-0" style="top:52%;left:78%;">🔺</div>
    <div class="fixed pointer-events-none text-3xl animate-float opacity-20 z-0" style="top:80%;left:86%;">🔷</div>
    {% include 'learning/partial/sidebar.html' %}
    <div id="mainArea" class="ml-[280px] flex-1 flex flex-col min-h-screen transition-all duration-300">
        <nav class="sticky top-0 z-[101] bg-white border-b-2 border-gray-200 px-5 py-3 flex items-center justify-between shadow-sm flex-shrink-0">
            <div class="flex items-center gap-3">
                <span id="menuToggleBtn" onclick="toggleSidebar()" class="text-[1.8rem] cursor-pointer text-gray-700 hover:text-emerald-500"><ion-icon name="menu-outline"></ion-icon></span>
                <span class="font-fredoka text-lg text-gray-700">⬜ Segiempat</span>
            </div>
        </nav>
        <div class="flex-1 px-6 py-6 bg-gradient-to-br from-cyan-50 via-green-50 to-yellow-50">
            <div class="max-w-5xl mx-auto flex flex-col gap-5">
                <div class="bg-white rounded-lg shadow-md overflow-hidden border-2 border-sky-100 flex flex-col">
                    <div class="bg-gradient-to-r from-sky-500 to-sky-600 px-5 py-5 text-center">
                        <h2 class="font-fredoka text-2xl text-white" style="text-shadow:2px 2px 0 rgba(0,0,0,0.15)">SEGIEMPAT</h2>
                        <p class="text-sky-50 text-sm font-bold mt-1">Persegi, Persegi Panjang, Jajar Genjang</p>
                    </div>
                    <div class="p-6 flex flex-col gap-5">
                        <p class="text-sm text-gray-700 leading-relaxed">Segiempat adalah bangun datar yang mempunyai <strong>4 sisi</strong> dan <strong>4 titik sudut</strong>.<br><br>Pada materi ini kita akan mengenal enam jenis segiempat, yaitu: <strong>Persegi, Persegi panjang, Jajar genjang, Belah ketupat, Trapesium, Layang-layang</strong></p>

                        <!-- 1. PERSEGI -->
                        <div>
                            <h3 class="font-fredoka text-xl text-sky-700 mb-2">1. Persegi</h3>
                            <p class="text-sm text-gray-700 mb-3">Persegi adalah segiempat yang mempunyai empat sisi sama panjang dan empat sudut siku-siku.<br>Contoh: permukaan wadai lam.</p>
                            <figure class="bg-white rounded-xl overflow-hidden border-2 border-sky-200 shadow-sm max-w-xs mx-auto">
                                <img src="/resources/views/learning/low/bangun_datar/persegi_asset/img/21.jpg" alt="Wadai lam" class="w-full h-40 object-contain bg-white">
                                <figcaption class="px-3 py-2 text-xs font-bold text-gray-600 text-center">Wadai Lam</figcaption>
                            </figure>
                        </div>

                        <div class="bg-gradient-to-br from-sky-50 to-sky-100 border-2 border-sky-200 rounded-2xl p-4">
                            <h4 class="font-fredoka text-lg text-sky-700 mb-3">Sifat-Sifat Persegi</h4>
                            <div class="grid gap-3">
                                <div class="bg-white rounded-xl p-3 border border-sky-200">
                                    <p class="text-sm font-bold text-sky-700 mb-2">• 4 titik sudut</p>
                                    <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/wadai_lam_empat_titik_sudut.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg">
                                </div>
                                <div class="bg-white rounded-xl p-3 border border-sky-200">
                                    <p class="text-sm font-bold text-sky-700 mb-2">• 4 sisi</p>
                                    <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/wadai_lam_empat_sisi.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg">
                                </div>
                                <div class="bg-white rounded-xl p-3 border border-sky-200">
                                    <p class="text-sm font-bold text-sky-700 mb-2">• 4 sudut</p>
                                    <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/empat_sudut_lam.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg">
                                </div>
                                <div class="bg-white rounded-xl p-3 border border-sky-200">
                                    <p class="text-sm font-bold text-sky-700 mb-2">• Simetri lipat (ada 4 simetri lipat)</p>
                                    <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/simetri_lipat_lam.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg">
                                </div>
                                <div class="bg-white rounded-xl p-3 border border-sky-200">
                                    <p class="text-sm font-bold text-sky-700 mb-2">• Simetri putar (ada 4 simetri putar)</p>
                                    <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/Simetri_putar_lam.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg">
                                </div>
                            </div>
                        </div>

                        <div>
                            <h3 class="font-fredoka text-xl text-sky-700 mb-2">Keliling Persegi</h3>
                            <p class="text-sm text-gray-700 mb-3">Rumus: <strong>K = s + s + s + s</strong> atau <strong>K = 4 × sisi</strong></p>
                            <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/keliling_lam.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[320px] mx-auto h-auto rounded-lg border border-sky-200">
                        </div>

                        <div class="bg-white rounded-2xl border-2 border-sky-200 overflow-hidden">
                            <div class="bg-sky-50 px-4 py-2"><p class="font-fredoka text-sky-700">🎮 Coba Jawab! - Keliling Persegi</p></div>
                            <div class="p-4 space-y-3 text-sm text-gray-700">
                                <p>Ibu membuat wadai lam berbentuk persegi. Setiap sisi panjangnya 5 cm. Berapakah keliling wadai lam tersebut?</p>
                                <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/sisi_sama_lam.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg">
                                <div class="flex flex-col sm:flex-row gap-2">
                                    <input id="ans-p1" type="text" placeholder="Contoh: 20" onkeydown="if(event.key==='Enter')periksaSoal('p1')" class="flex-1 rounded-xl border-2 border-sky-200 px-4 py-2.5 text-sm">
                                    <button onclick="periksaSoal('p1')" class="bg-sky-500 hover:bg-sky-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button>
                                </div>
                                <div id="fb-p1"></div>
                                <div id="sol-p1" class="hidden bg-sky-50/60 rounded-xl p-3">
                                    <p class="font-bold text-sky-700 mb-1">Pembahasan:</p>
                                    <p>K = 5 + 5 + 5 + 5 = <strong>20 cm</strong> atau K = 4 × 5 = <strong>20 cm</strong></p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white rounded-2xl border-2 border-sky-200 overflow-hidden">
                            <div class="bg-sky-50 px-4 py-2"><p class="font-fredoka text-sky-700">🎮 Coba Jawab! - Mencari Sisi Persegi</p></div>
                            <div class="p-4 space-y-3 text-sm text-gray-700">
                                <p>Sebuah papan rambu-rambu perahu mempunyai keliling 20 cm. Berapakah panjang satu sisinya?</p>
                                <figure class="bg-white rounded-xl overflow-hidden border-2 border-sky-200 shadow-sm max-w-xs mx-auto">
                                    <img src="/resources/views/learning/low/bangun_datar/persegi_asset/img/22.jpg" alt="Papan rambu-rambu perahu" class="w-full h-40 object-contain bg-white">
                                    <figcaption class="px-3 py-2 text-xs font-bold text-gray-600 text-center">Papan Rambu-Rambu Perahu</figcaption>
                                </figure>
                                <div class="flex flex-col sm:flex-row gap-2">
                                    <input id="ans-p2" type="text" placeholder="Contoh: 5" onkeydown="if(event.key==='Enter')periksaSoal('p2')" class="flex-1 rounded-xl border-2 border-sky-200 px-4 py-2.5 text-sm">
                                    <button onclick="periksaSoal('p2')" class="bg-sky-500 hover:bg-sky-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button>
                                </div>
                                <div id="fb-p2"></div>
                                <div id="sol-p2" class="hidden bg-sky-50/60 rounded-xl p-3">
                                    <p class="font-bold text-sky-700 mb-1">Pembahasan:</p>
                                    <p>K = 4 × sisi → 20 = 4 × sisi → sisi = 20 ÷ 4 = <strong>5 cm</strong></p>
                                </div>
                            </div>
                        </div>

                        <div>
                            <h3 class="font-fredoka text-xl text-sky-700 mb-2">Luas Persegi</h3>
                            <p class="text-sm text-gray-700 mb-3">Rumus: <strong>L = sisi × sisi</strong></p>
                            <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/luas_lam.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[320px] mx-auto h-auto rounded-lg border border-sky-200">
                        </div>

                        <div class="bg-white rounded-2xl border-2 border-sky-200 overflow-hidden">
                            <div class="bg-sky-50 px-4 py-2"><p class="font-fredoka text-sky-700">🎮 Coba Jawab! - Luas Persegi</p></div>
                            <div class="p-4 space-y-3 text-sm text-gray-700">
                                <p>Ibu membuat wadai lam berbentuk persegi dengan panjang sisi 5 cm. Berapakah luasnya?</p>
                                <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/luas_lam_sisi.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg">
                                <div class="flex flex-col sm:flex-row gap-2">
                                    <input id="ans-p3" type="text" placeholder="Contoh: 25" onkeydown="if(event.key==='Enter')periksaSoal('p3')" class="flex-1 rounded-xl border-2 border-sky-200 px-4 py-2.5 text-sm">
                                    <button onclick="periksaSoal('p3')" class="bg-sky-500 hover:bg-sky-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button>
                                </div>
                                <div id="fb-p3"></div>
                                <div id="sol-p3" class="hidden bg-sky-50/60 rounded-xl p-3">
                                    <p class="font-bold text-sky-700 mb-1">Pembahasan:</p>
                                    <p>L = sisi × sisi = 5 × 5 = <strong>25 cm²</strong></p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white rounded-2xl border-2 border-sky-200 overflow-hidden">
                            <div class="bg-sky-50 px-4 py-2"><p class="font-fredoka text-sky-700">🎮 Coba Jawab! - Mencari Sisi Luas Persegi</p></div>
                            <div class="p-4 space-y-3 text-sm text-gray-700">
                                <p>Sebuah papan rambu-rambu perahu mempunyai luas 9 m². Berapakah panjang sisinya?</p>
                                <div class="flex flex-col sm:flex-row gap-2">
                                    <input id="ans-p4" type="text" placeholder="Contoh: 3" onkeydown="if(event.key==='Enter')periksaSoal('p4')" class="flex-1 rounded-xl border-2 border-sky-200 px-4 py-2.5 text-sm">
                                    <button onclick="periksaSoal('p4')" class="bg-sky-500 hover:bg-sky-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button>
                                </div>
                                <div id="fb-p4"></div>
                                <div id="sol-p4" class="hidden bg-sky-50/60 rounded-xl p-3">
                                    <p class="font-bold text-sky-700 mb-1">Pembahasan:</p>
                                    <p>√9 = <strong>3 m</strong></p>
                                </div>
                            </div>
                        </div>

                        <!-- 2. PERSEGI PANJANG -->
                        <div>
                            <h3 class="font-fredoka text-xl text-teal-700 mb-2">2. Persegi Panjang</h3>
                            <p class="text-sm text-gray-700 mb-3">Persegi panjang adalah bangun datar yang mempunyai dua pasang sisi berhadapan sama panjang dan empat sudut siku-siku.<br>Contoh: tas purun</p>
                            <figure class="bg-white rounded-xl overflow-hidden border-2 border-teal-200 shadow-sm max-w-xs mx-auto">
                                <img src="/resources/views/learning/low/bangun_datar/persegi_asset/img/23.jpg" alt="Tas purun" class="w-full h-40 object-contain bg-white">
                                <figcaption class="px-3 py-2 text-xs font-bold text-gray-600 text-center">Tas Purun</figcaption>
                            </figure>
                        </div>

                        <div class="bg-gradient-to-br from-teal-50 to-teal-100 border-2 border-teal-200 rounded-2xl p-4">
                            <h4 class="font-fredoka text-lg text-teal-700 mb-3">Sifat-Sifat Persegi Panjang</h4>
                            <div class="grid gap-3">
                                <div class="bg-white rounded-xl p-3 border border-teal-200">
                                    <p class="text-sm font-bold text-teal-700 mb-2">• 4 titik sudut</p>
                                    <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/titik_sudut_tas.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg">
                                </div>
                                <div class="bg-white rounded-xl p-3 border border-teal-200">
                                    <p class="text-sm font-bold text-teal-700 mb-2">• 4 sisi (2 pasang sama panjang)</p>
                                    <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/tas_purun_4_sisi.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg">
                                </div>
                                <div class="bg-white rounded-xl p-3 border border-teal-200">
                                    <p class="text-sm font-bold text-teal-700 mb-2">• 4 sudut</p>
                                    <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/tas_purun_4_sudut.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg">
                                </div>
                                <div class="bg-white rounded-xl p-3 border border-teal-200">
                                    <p class="text-sm font-bold text-teal-700 mb-2">• Simetri lipat (ada 2 simetri lipat)</p>
                                    <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/Tas_purun_simetri_lipat.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg">
                                </div>
                                <div class="bg-white rounded-xl p-3 border border-teal-200">
                                    <p class="text-sm font-bold text-teal-700 mb-2">• Simetri putar (ada 2 simetri putar)</p>
                                    <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/tas_purun_simetri_putar.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg">
                                </div>
                            </div>
                        </div>

                        <div>
                            <h3 class="font-fredoka text-xl text-teal-700 mb-2">Keliling Persegi Panjang</h3>
                            <p class="text-sm text-gray-700 mb-3">Rumus: <strong>K = p + p + l + l</strong> atau <strong>K = 2 × (p + l)</strong></p>
                            <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/tas_purun_keliling.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[320px] mx-auto h-auto rounded-lg border border-teal-200">
                        </div>

                        <div class="bg-white rounded-2xl border-2 border-teal-200 overflow-hidden">
                            <div class="bg-teal-50 px-4 py-2"><p class="font-fredoka text-teal-700">🎮 Coba Jawab! - Keliling Persegi Panjang</p></div>
                            <div class="p-4 space-y-3 text-sm text-gray-700">
                                <p>Sebuah jendela pada jukung berbentuk persegi panjang. Panjang 8 cm dan lebar 4 cm. Berapakah kelilingnya?</p>
                                <figure class="bg-white rounded-xl overflow-hidden border-2 border-teal-200 shadow-sm max-w-xs mx-auto">
                                    <img src="/resources/views/learning/low/bangun_datar/persegi_asset/img/24.jpg" alt="Jendela jukung" class="w-full h-40 object-contain bg-white">
                                    <figcaption class="px-3 py-2 text-xs font-bold text-gray-600 text-center">Jendela Jukung</figcaption>
                                </figure>
                                <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/jendela_jukung_persegi_panjang.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg">
                                <div class="flex flex-col sm:flex-row gap-2">
                                    <input id="ans-p5" type="text" placeholder="Contoh: 24" onkeydown="if(event.key==='Enter')periksaSoal('p5')" class="flex-1 rounded-xl border-2 border-teal-200 px-4 py-2.5 text-sm">
                                    <button onclick="periksaSoal('p5')" class="bg-teal-500 hover:bg-teal-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button>
                                </div>
                                <div id="fb-p5"></div>
                                <div id="sol-p5" class="hidden bg-teal-50/60 rounded-xl p-3">
                                    <p class="font-bold text-teal-700 mb-1">Pembahasan:</p>
                                    <p>K = 2 × (8 + 4) = 2 × 12 = <strong>24 cm</strong></p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white rounded-2xl border-2 border-teal-200 overflow-hidden">
                            <div class="bg-teal-50 px-4 py-2"><p class="font-fredoka text-teal-700">🎮 Coba Jawab! - Mencari Lebar Persegi Panjang</p></div>
                            <div class="p-4 space-y-3 text-sm text-gray-700">
                                <p>Sebuah tas purun mempunyai panjang 8 cm dan keliling 24 cm. Berapakah lebarnya?</p>
                                <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/tas_purun_keliling_cari_sisi.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg">
                                <div class="flex flex-col sm:flex-row gap-2">
                                    <input id="ans-p6" type="text" placeholder="Contoh: 4" onkeydown="if(event.key==='Enter')periksaSoal('p6')" class="flex-1 rounded-xl border-2 border-teal-200 px-4 py-2.5 text-sm">
                                    <button onclick="periksaSoal('p6')" class="bg-teal-500 hover:bg-teal-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button>
                                </div>
                                <div id="fb-p6"></div>
                                <div id="sol-p6" class="hidden bg-teal-50/60 rounded-xl p-3">
                                    <p class="font-bold text-teal-700 mb-1">Pembahasan:</p>
                                    <p>24 = 2 × (8 + lebar) → 12 = 8 + lebar → lebar = <strong>4 cm</strong></p>
                                </div>
                            </div>
                        </div>

                        <div>
                            <h3 class="font-fredoka text-xl text-teal-700 mb-2">Luas Persegi Panjang</h3>
                            <p class="text-sm text-gray-700 mb-3">Rumus: <strong>L = panjang × lebar</strong></p>
                            <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/jendela_jukung_luas.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[320px] mx-auto h-auto rounded-lg border border-teal-200">
                        </div>

                        <div class="bg-white rounded-2xl border-2 border-teal-200 overflow-hidden">
                            <div class="bg-teal-50 px-4 py-2"><p class="font-fredoka text-teal-700">🎮 Coba Jawab! - Luas Persegi Panjang</p></div>
                            <div class="p-4 space-y-3 text-sm text-gray-700">
                                <p>Kain sasirangan berbentuk persegi panjang, panjang 8 cm, lebar 4 cm. Berapakah luasnya?</p>
                                <figure class="bg-white rounded-xl overflow-hidden border-2 border-teal-200 shadow-sm max-w-xs mx-auto">
                                    <img src="/resources/views/learning/low/bangun_datar/persegi_asset/img/25.jpg" alt="Kain sasirangan" class="w-full h-40 object-contain bg-white">
                                    <figcaption class="px-3 py-2 text-xs font-bold text-gray-600 text-center">Kain Sasirangan</figcaption>
                                </figure>
                                <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/kain_sasirangan_persegi_panjang.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg">
                                <div class="flex flex-col sm:flex-row gap-2">
                                    <input id="ans-p7" type="text" placeholder="Contoh: 32" onkeydown="if(event.key==='Enter')periksaSoal('p7')" class="flex-1 rounded-xl border-2 border-teal-200 px-4 py-2.5 text-sm">
                                    <button onclick="periksaSoal('p7')" class="bg-teal-500 hover:bg-teal-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button>
                                </div>
                                <div id="fb-p7"></div>
                                <div id="sol-p7" class="hidden bg-teal-50/60 rounded-xl p-3">
                                    <p class="font-bold text-teal-700 mb-1">Pembahasan:</p>
                                    <p>L = 8 × 4 = <strong>32 cm²</strong></p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white rounded-2xl border-2 border-teal-200 overflow-hidden">
                            <div class="bg-teal-50 px-4 py-2"><p class="font-fredoka text-teal-700">🎮 Coba Jawab! - Mencari Panjang Persegi Panjang</p></div>
                            <div class="p-4 space-y-3 text-sm text-gray-700">
                                <p>Sebuah tas purun mempunyai luas 32 cm² dan lebar 4 cm. Berapakah panjangnya?</p>
                                <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/tas_purun_luas_cari_sisi.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg">
                                <div class="flex flex-col sm:flex-row gap-2">
                                    <input id="ans-p8" type="text" placeholder="Contoh: 8" onkeydown="if(event.key==='Enter')periksaSoal('p8')" class="flex-1 rounded-xl border-2 border-teal-200 px-4 py-2.5 text-sm">
                                    <button onclick="periksaSoal('p8')" class="bg-teal-500 hover:bg-teal-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button>
                                </div>
                                <div id="fb-p8"></div>
                                <div id="sol-p8" class="hidden bg-teal-50/60 rounded-xl p-3">
                                    <p class="font-bold text-teal-700 mb-1">Pembahasan:</p>
                                    <p>L = p × l → 32 = p × 4 → p = 32 ÷ 4 = <strong>8 cm</strong></p>
                                </div>
                            </div>
                        </div>

                        <!-- 3. JAJAR GENJANG -->
                        <div>
                            <h3 class="font-fredoka text-xl text-rose-700 mb-2">3. Jajar Genjang</h3>
                            <p class="text-sm text-gray-700 mb-3">Jajar genjang adalah segiempat yang mempunyai dua pasang sisi berhadapan sama panjang dan sejajar.<br>Contoh: permukaan wadai gagatas</p>
                            <figure class="bg-white rounded-xl overflow-hidden border-2 border-rose-200 shadow-sm max-w-xs mx-auto">
                                <img src="/resources/views/learning/low/bangun_datar/persegi_asset/img/26.jpg" alt="Wadai gagatas" class="w-full h-40 object-contain bg-white">
                                <figcaption class="px-3 py-2 text-xs font-bold text-gray-600 text-center">Wadai Gagatas</figcaption>
                            </figure>
                        </div>

                        <div class="bg-gradient-to-br from-rose-50 to-rose-100 border-2 border-rose-200 rounded-2xl p-4">
                            <h4 class="font-fredoka text-lg text-rose-700 mb-3">Sifat-Sifat Jajar Genjang</h4>
                            <div class="grid gap-3">
                                <div class="bg-white rounded-xl p-3 border border-rose-200">
                                    <p class="text-sm font-bold text-rose-700 mb-2">• 4 titik sudut</p>
                                    <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/gagatas_jajar_genjang_4_titik_sudut.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg">
                                </div>
                                <div class="bg-white rounded-xl p-3 border border-rose-200">
                                    <p class="text-sm font-bold text-rose-700 mb-2">• 4 sisi</p>
                                    <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/gagatas_jajar_genjang_4_sisi.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg">
                                </div>
                                <div class="bg-white rounded-xl p-3 border border-rose-200">
                                    <p class="text-sm font-bold text-rose-700 mb-2">• 4 sudut</p>
                                    <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/gagatas_jajar_genjang_4_sudut.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg">
                                </div>
                                <div class="bg-white rounded-xl p-3 border border-rose-200">
                                    <p class="text-sm font-bold text-rose-700 mb-2">• Simetri lipat (tidak ada)</p>
                                    <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/gagatas_jajar_genjang_simetri_lipat.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg">
                                </div>
                                <div class="bg-white rounded-xl p-3 border border-rose-200">
                                    <p class="text-sm font-bold text-rose-700 mb-2">• Simetri putar (ada 2)</p>
                                    <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/gagatas_jajar_genjang_simetri_putar.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[260px] mx-auto h-auto rounded-lg">
                                </div>
                            </div>
                        </div>

                        <div>
                            <h3 class="font-fredoka text-xl text-rose-700 mb-2">Keliling Jajar Genjang</h3>
                            <p class="text-sm text-gray-700 mb-3">Rumus: <strong>K = 2 × (sisi 1 + sisi 2)</strong></p>
                            <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/gagatas_jajar_genjang_keliling.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[320px] mx-auto h-auto rounded-lg border border-rose-200">
                        </div>

                        <div class="bg-white rounded-2xl border-2 border-rose-200 overflow-hidden">
                            <div class="bg-rose-50 px-4 py-2"><p class="font-fredoka text-rose-700">🎮 Coba Jawab! - Keliling Jajar Genjang</p></div>
                            <div class="p-4 space-y-3 text-sm text-gray-700">
                                <p>Motif kain sasirangan berbentuk jajar genjang dengan sisi 3 cm dan 2 cm. Berapakah kelilingnya?</p>
                                <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/motif_sasirangan_jajar_genjang_keliling.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg">
                                <div class="flex flex-col sm:flex-row gap-2">
                                    <input id="ans-p9" type="text" placeholder="Contoh: 10" onkeydown="if(event.key==='Enter')periksaSoal('p9')" class="flex-1 rounded-xl border-2 border-rose-200 px-4 py-2.5 text-sm">
                                    <button onclick="periksaSoal('p9')" class="bg-rose-500 hover:bg-rose-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button>
                                </div>
                                <div id="fb-p9"></div>
                                <div id="sol-p9" class="hidden bg-rose-50/60 rounded-xl p-3">
                                    <p class="font-bold text-rose-700 mb-1">Pembahasan:</p>
                                    <p>K = 2 × (3 + 2) = 2 × 5 = <strong>10 cm</strong></p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white rounded-2xl border-2 border-rose-200 overflow-hidden">
                            <div class="bg-rose-50 px-4 py-2"><p class="font-fredoka text-rose-700">🎮 Coba Jawab! - Mencari Sisi Jajar Genjang</p></div>
                            <div class="p-4 space-y-3 text-sm text-gray-700">
                                <p>Wadai gagatas berbentuk jajar genjang keliling 26 cm, salah satu sisi 8 cm. Berapakah sisi lainnya?</p>
                                <div class="flex flex-col sm:flex-row gap-2">
                                    <input id="ans-p10" type="text" placeholder="Contoh: 5" onkeydown="if(event.key==='Enter')periksaSoal('p10')" class="flex-1 rounded-xl border-2 border-rose-200 px-4 py-2.5 text-sm">
                                    <button onclick="periksaSoal('p10')" class="bg-rose-500 hover:bg-rose-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button>
                                </div>
                                <div id="fb-p10"></div>
                                <div id="sol-p10" class="hidden bg-rose-50/60 rounded-xl p-3">
                                    <p class="font-bold text-rose-700 mb-1">Pembahasan:</p>
                                    <p>26 = 2 × (8 + sisi) → 13 = 8 + sisi → sisi = <strong>5 cm</strong></p>
                                </div>
                            </div>
                        </div>

                        <div>
                            <h3 class="font-fredoka text-xl text-rose-700 mb-2">Luas Jajar Genjang</h3>
                            <p class="text-sm text-gray-700 mb-3">Rumus: <strong>L = alas × tinggi</strong></p>
                            <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/gagatas_jajar_genjang_luas.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[320px] mx-auto h-auto rounded-lg border border-rose-200">
                        </div>

                        <div class="bg-white rounded-2xl border-2 border-rose-200 overflow-hidden">
                            <div class="bg-rose-50 px-4 py-2"><p class="font-fredoka text-rose-700">🎮 Coba Jawab! - Luas Jajar Genjang</p></div>
                            <div class="p-4 space-y-3 text-sm text-gray-700">
                                <p>Wadai gagatas berbentuk jajar genjang, alas 8 cm, tinggi 4 cm. Berapakah luasnya?</p>
                                <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/gagatas_jajar_genjang_luas_warna.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg">
                                <div class="flex flex-col sm:flex-row gap-2">
                                    <input id="ans-p11" type="text" placeholder="Contoh: 32" onkeydown="if(event.key==='Enter')periksaSoal('p11')" class="flex-1 rounded-xl border-2 border-rose-200 px-4 py-2.5 text-sm">
                                    <button onclick="periksaSoal('p11')" class="bg-rose-500 hover:bg-rose-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button>
                                </div>
                                <div id="fb-p11"></div>
                                <div id="sol-p11" class="hidden bg-rose-50/60 rounded-xl p-3">
                                    <p class="font-bold text-rose-700 mb-1">Pembahasan:</p>
                                    <p>L = 8 × 4 = <strong>32 cm²</strong></p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white rounded-2xl border-2 border-rose-200 overflow-hidden">
                            <div class="bg-rose-50 px-4 py-2"><p class="font-fredoka text-rose-700">🎮 Coba Jawab! - Mencari Alas Jajar Genjang</p></div>
                            <div class="p-4 space-y-3 text-sm text-gray-700">
                                <p>Motif sasirangan berbentuk jajar genjang luas 24 cm², tinggi 4 cm. Berapakah alasnya?</p>
                                <img data-src="/resources/views/learning/low/bangun_datar/persegi_asset/gif/motif_sasirangan_jajar_genjang_luas.gif" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" class="gif-lazy w-full max-w-[280px] mx-auto h-auto rounded-lg">
                                <div class="flex flex-col sm:flex-row gap-2">
                                    <input id="ans-p12" type="text" placeholder="Contoh: 6" onkeydown="if(event.key==='Enter')periksaSoal('p12')" class="flex-1 rounded-xl border-2 border-rose-200 px-4 py-2.5 text-sm">
                                    <button onclick="periksaSoal('p12')" class="bg-rose-500 hover:bg-rose-600 text-white font-bold px-5 py-2.5 rounded-xl text-sm">Periksa Jawaban</button>
                                </div>
                                <div id="fb-p12"></div>
                                <div id="sol-p12" class="hidden bg-rose-50/60 rounded-xl p-3">
                                    <p class="font-bold text-rose-700 mb-1">Pembahasan:</p>
                                    <p>alas = 24 ÷ 4 = <strong>6 cm</strong></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex justify-between items-center flex-wrap gap-3 pb-4">
                    <a href="/learning/bangun_datar/04/{{ user_id }}/{{ klasifikasi }}" class="font-fredoka text-base px-6 py-2.5 rounded-lg bg-gradient-to-r from-emerald-500 to-emerald-600 text-white shadow-md">⬅️ Halaman Sebelumnya</a>
                    <p class="text-gray-400 text-xs font-semibold">© 2026 Edudaya 🔷</p>
                    <a href="/learning/bangun_datar/06/{{ user_id }}/{{ klasifikasi }}" class="font-fredoka text-base px-6 py-2.5 rounded-lg bg-gradient-to-r from-purple-500 to-purple-600 text-white shadow-md">Halaman Selanjutnya ➡️</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        const JAWABAN_SOAL = { 'p1':20,'p2':5,'p3':25,'p4':3,'p5':24,'p6':4,'p7':32,'p8':8,'p9':10,'p10':5,'p11':32,'p12':6 };
        function periksaSoal(id){
            const input=document.getElementById('ans-'+id), fb=document.getElementById('fb-'+id), sol=document.getElementById('sol-'+id);
            if(!input||!fb)return;
            let val=input.value.trim().replace(/\s+/g,'');
            if(val===''){fb.innerHTML='<div class="bg-yellow-100 border-2 border-yellow-400 rounded-xl p-3 text-sm font-bold text-yellow-700">✏️ Tulis jawabanmu dulu ya!</div>';return;}
            const num=parseFloat(val.replace(',','.'));
            const ben=JAWABAN_SOAL[id];
            if(!isNaN(num)&&Math.abs(num-ben)<0.01){fb.innerHTML='<div class="bg-green-100 border-2 border-green-400 rounded-xl p-3 text-sm font-bold text-green-700">🎉 BENAR! Hebat!</div>'; if(sol)sol.classList.remove('hidden');}
            else{fb.innerHTML='<div class="bg-red-100 border-2 border-red-400 rounded-xl p-3 text-sm font-bold text-red-600">😊 BELUM TEPAT! Coba perhatikan lagi ya!</div>'; if(sol)sol.classList.remove('hidden');}
        }
        let sidebarOpen=true;
        function toggleSidebar(){const s=document.getElementById('sidebar'),m=document.getElementById('mainArea'),o=document.getElementById('sidebarOverlay'),mob=window.innerWidth<=768;if(mob){const h=s.classList.contains('-translate-x-full');if(h){s.classList.remove('-translate-x-full');o.classList.remove('hidden');o.classList.add('flex');}else{s.classList.add('-translate-x-full');o.classList.add('hidden');o.classList.remove('flex');}}else{sidebarOpen=!sidebarOpen;if(sidebarOpen){s.classList.remove('-translate-x-full');m.classList.remove('ml-0');m.classList.add('ml-[280px]');}else{s.classList.add('-translate-x-full');m.classList.remove('ml-[280px]');m.classList.add('ml-0');}}}
        function closeSidebar(){const s=document.getElementById('sidebar'),o=document.getElementById('sidebarOverlay');s.classList.add('-translate-x-full');o.classList.add('hidden');o.classList.remove('flex');}
        function toggleSidebarMenu(h){const i=h.querySelector('ion-icon'),l=h.nextElementSibling;const op=!l.classList.contains('hidden');l.classList.toggle('hidden',op);l.classList.toggle('flex',!op);i.style.transform=op?'':'rotate(180deg)';}
        function initSidebar(){var p=window.location.pathname;document.querySelectorAll('#sidebar a').forEach(function(a){if(a.getAttribute('href')&&p.startsWith(a.getAttribute('href').split('/').slice(0,5).join('/'))){var u=a.closest('ul');if(u&&u.classList.contains('hidden')){var hh=u.previousElementSibling;if(hh&&hh.querySelector('ion-icon')){u.classList.remove('hidden');u.classList.add('flex');hh.querySelector('ion-icon').style.transform='rotate(180deg)';}}}});}
        document.addEventListener('DOMContentLoaded',()=>{if(window.innerWidth<=768){document.getElementById('sidebar').classList.add('-translate-x-full');document.getElementById('mainArea').classList.remove('ml-[280px]');document.getElementById('mainArea').classList.add('ml-0');}initSidebar();});
    </script>
    <!-- Lightbox -->
    <div id="imgLightbox" class="fixed inset-0 bg-black/80 hidden items-center justify-center z-[9999] p-4" onclick="closeLightbox()">
        <button class="absolute top-4 right-4 text-white text-3xl" onclick="closeLightbox(event)">&times;</button>
        <img id="imgLightboxImg" src="" alt="Preview" class="max-w-full max-h-full rounded-lg shadow-2xl" onclick="event.stopPropagation()">
    </div>
    <script>
        function openLightbox(src,alt){const lb=document.getElementById('imgLightbox'),img=document.getElementById('imgLightboxImg');if(!lb||!img)return;img.src=src;if(alt)img.alt=alt;lb.classList.remove('hidden');lb.classList.add('flex');document.body.style.overflow='hidden';}
        function closeLightbox(e){if(e)e.stopPropagation();const lb=document.getElementById('imgLightbox');if(!lb)return;lb.classList.add('hidden');lb.classList.remove('flex');document.body.style.overflow='';}
        document.addEventListener('DOMContentLoaded', function(){
            const gifs=document.querySelectorAll('img.gif-lazy');
            if('IntersectionObserver' in window){const obs=new IntersectionObserver((entries)=>{entries.forEach(e=>{if(e.isIntersecting){const img=e.target;if(img.dataset.src){img.src=img.dataset.src;img.removeAttribute('data-src');}obs.unobserve(img);}});},{rootMargin:'50px'});gifs.forEach(g=>obs.observe(g));}else{gifs.forEach(img=>{if(img.dataset.src){img.src=img.dataset.src;img.removeAttribute('data-src');}});}
            document.querySelectorAll('img').forEach(img => {
                if(img.closest('#sidebar')||img.closest('nav')||img.id==='imgLightboxImg')return;
                if(img.src && !img.classList.contains('no-lightbox')){
                    img.style.cursor='zoom-in';
                    img.addEventListener('click',function(e){e.preventDefault();openLightbox(img.currentSrc||img.src,img.alt);});
                }
            });
        });
    </script>
</body>
</html>